import 'dart:math';
import 'package:flutter/material.dart';

/// Paints a realistic hanging rope with diagonal strand texture, soft shadows,
/// highlights, slight imperfections, and a natural gravity-induced sag.
///
/// The rope is drawn from [start] to [end] with a catenary-like curve.
class RopePainter extends CustomPainter {
  final Offset start;
  final Offset end;
  final double thickness;
  final double sagAmount;
  final int seed;

  const RopePainter({
    required this.start,
    required this.end,
    this.thickness = 5.0,
    this.sagAmount = 12.0,
    this.seed = 42,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    // ── 1. Compute catenary-like sag path ────────────────────────────────
    final dx = end.dx - start.dx;
    final dy = end.dy - start.dy;
    final length = sqrt(dx * dx + dy * dy);
    final segments = 40;

    final path = Path();
    final points = <Offset>[];

    for (int i = 0; i <= segments; i++) {
      final t = i / segments;
      // Catenary sag: maximum at center, zero at ends
      final sag = sagAmount * sin(t * pi);
      final px = start.dx + dx * t;
      final py = start.dy + dy * t + sag;
      points.add(Offset(px, py));
    }

    path.moveTo(points[0].dx, points[0].dy);
    for (int i = 1; i < points.length; i++) {
      path.lineTo(points[i].dx, points[i].dy);
    }

    // ── 2. Drop shadow (behind rope) ─────────────────────────────────────
    final shadowPaint = Paint()
      ..color = Colors.black.withValues(alpha: 0.18)
      ..style = PaintingStyle.stroke
      ..strokeWidth = thickness + 2
      ..strokeCap = StrokeCap.round
      ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 2.5);
    canvas.drawPath(path, shadowPaint);

    // ── 3. Base rope body (dark brown) ────────────────────────────────────
    final basePaint = Paint()
      ..color = const Color(0xFF5C3A1E)
      ..style = PaintingStyle.stroke
      ..strokeWidth = thickness
      ..strokeCap = StrokeCap.round;
    canvas.drawPath(path, basePaint);

    // ── 4. Diagonal strand texture ───────────────────────────────────────
    final r = Random(seed);
    final strandPaint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 0.8
      ..strokeCap = StrokeCap.round;

    // Direction perpendicular to rope for strand angle
    final angle = atan2(dy, dx);
    final strandAngle = angle + pi / 4; // 45-degree diagonal strands

    for (int i = 0; i < points.length - 1; i++) {
      final p1 = points[i];
      final p2 = points[i + 1];
      final mid = Offset((p1.dx + p2.dx) / 2, (p1.dy + p2.dy) / 2);

      // Draw multiple diagonal strands across the rope width
      for (int s = -2; s <= 2; s++) {
        final offset = s * (thickness * 0.3);
        final perpX = cos(angle + pi / 2) * offset;
        final perpY = sin(angle + pi / 2) * offset;

        final strandLen = thickness * 0.45;
        final sx1 = mid.dx + perpX - cos(strandAngle) * strandLen;
        final sy1 = mid.dy + perpY - sin(strandAngle) * strandLen;
        final sx2 = mid.dx + perpX + cos(strandAngle) * strandLen;
        final sy2 = mid.dy + perpY + sin(strandAngle) * strandLen;

        // Alternate light and dark strands
        final isLight = (i + s) % 2 == 0;
        if (isLight) {
          strandPaint.color = const Color(0xFF8B5A2B).withValues(alpha: 0.55 + r.nextDouble() * 0.2);
        } else {
          strandPaint.color = const Color(0xFF3D2410).withValues(alpha: 0.65 + r.nextDouble() * 0.2);
        }
        canvas.drawLine(Offset(sx1, sy1), Offset(sx2, sy2), strandPaint);
      }
    }

    // ── 5. Soft highlights (top edge) ─────────────────────────────────────
    final highlightPaint = Paint()
      ..color = const Color(0xFFC4915A).withValues(alpha: 0.35)
      ..style = PaintingStyle.stroke
      ..strokeWidth = thickness * 0.3
      ..strokeCap = StrokeCap.round;

    final highlightPath = Path();
    for (int i = 0; i < points.length; i++) {
      final p = points[i];
      final perpX = cos(angle + pi / 2) * (thickness * 0.3);
      final perpY = sin(angle + pi / 2) * (thickness * 0.3);
      final hp = Offset(p.dx + perpX, p.dy + perpY);
      if (i == 0) {
        highlightPath.moveTo(hp.dx, hp.dy);
      } else {
        highlightPath.lineTo(hp.dx, hp.dy);
      }
    }
    canvas.drawPath(highlightPath, highlightPaint);

    // ── 6. Small imperfections (random dark spots) ───────────────────────
    final imperfectionPaint = Paint()..style = PaintingStyle.fill;
    final rImp = Random(seed + 7);
    for (int i = 0; i < points.length; i += 3) {
      if (rImp.nextDouble() > 0.6) {
        final p = points[i];
        imperfectionPaint.color =
            const Color(0xFF2A1808).withValues(alpha: 0.4 + rImp.nextDouble() * 0.3);
        canvas.drawCircle(p, 0.8 + rImp.nextDouble() * 0.6, imperfectionPaint);
      }
    }

    // ── 7. Rope end knots (small circles at attachment points) ───────────
    final knotPaint = Paint()
      ..color = const Color(0xFF4A2E15)
      ..style = PaintingStyle.fill;
    final knotHighlight = Paint()
      ..color = const Color(0xFF8B5A2B).withValues(alpha: 0.4)
      ..style = PaintingStyle.fill;

    // Top knot
    canvas.drawCircle(start, thickness * 0.7, knotPaint);
    canvas.drawCircle(
      Offset(start.dx - 1, start.dy - 1),
      thickness * 0.3,
      knotHighlight,
    );

    // Bottom knot
    canvas.drawCircle(end, thickness * 0.7, knotPaint);
    canvas.drawCircle(
      Offset(end.dx - 1, end.dy - 1),
      thickness * 0.3,
      knotHighlight,
    );
  }

  @override
  bool shouldRepaint(covariant RopePainter old) =>
      old.start != start ||
      old.end != end ||
      old.thickness != thickness ||
      old.sagAmount != sagAmount ||
      old.seed != seed;
}